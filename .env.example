# 复制成 .env 后填写;也可以不填,直接在网页"设置"里填(保存到 config.json)

# 转写:任何 OpenAI 兼容的 /audio/transcriptions 接口
# Groq(推荐,有免费额度):https://api.groq.com/openai/v1  模型 whisper-large-v3-turbo
# OpenAI:https://api.openai.com/v1  模型 whisper-1 或 gpt-4o-transcribe
# 硅基流动:https://api.siliconflow.cn/v1  模型 FunAudioLLM/SenseVoiceSmall
# 本地 whisper.cpp server:http://127.0.0.1:8080/v1
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_LANGUAGE=zh

# 纪要:Claude
ANTHROPIC_API_KEY=
# 用中转站才需要填
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-opus-5-5

# 纪要:OpenAI 兼容接口(SUMMARY_PROVIDER=openai 时生效)
# MOI Genesis:https://token.moi.matrixorigin.cn/v1,Key 用服务账号签发的 sk-sa-v1-… 
GENESIS_BASE_URL=https://token.moi.matrixorigin.cn/v1
GENESIS_API_KEY=
GENESIS_MODEL=qwen3.8-flash

PORT=3456
